{
  "name": "@feedyarder/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "backfill": "tsx src/backfill.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --exclude src/runner.integration.test.ts",
    "test:integration": "vitest run src/runner.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@feedyarder/contracts": "0.1.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.3",
    "parse5": "^8.0.1",
    "pg": "^8.14.1",
    "puppeteer-core": "^25.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "eslint": "^9.25.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
